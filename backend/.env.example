# ---------------------------------------------------------------------------
# Django backend environment template
# Copy to `backend/.env` and fill in real values.
# ---------------------------------------------------------------------------

# Django
# ---------------------------------------------------------------------------
# Use `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
SECRET_KEY=django-insecure-change-me-please
DEBUG=True
# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# ---------------------------------------------------------------------------
# Option A - full connection string (Supabase / Railway / Heroku style):
# DATABASE_URL=postgres://cph:cph@db:5432/cph
# For production managed databases set: DB_SSL_REQUIRE=True
#
# Option B - individual parameters (used when DATABASE_URL is absent):
DB_NAME=cph
DB_USER=cph
DB_PASSWORD=cph
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=False
#
# If neither DATABASE_URL nor DB_NAME is set, dev falls back to a local SQLite
# file (backend/db.sqlite3) so the server always boots.

# CORS / CSRF (comma separated origins)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary (media storage)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (email) - used by cph_app email helpers
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Production-only hardening flags
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True