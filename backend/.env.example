# ---------------------------------------------------------------------------
# Django backend environment template
# Copy to `backend/.env` and fill in real values.
# ---------------------------------------------------------------------------

# ── Django Core ─────────────────────────────────────────────────────────────
# Generate a real key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-please
DEBUG=True
# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev
# Comma-separated list. Dev: * or localhost. Prod: your actual domains.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ────────────────────────────────────────────────────────────────
# Option A — full connection string (Supabase / Railway / Render style):
DATABASE_URL=postgres://user:password@host:5432/dbname
# For production managed databases set: DB_SSL_REQUIRE=True
#
# Option B — individual parameters (used when DATABASE_URL is absent):
# DB_NAME=cph
# DB_USER=cph
# DB_PASSWORD=cph
# DB_HOST=db
# DB_PORT=5432
# DB_SSL_REQUIRE=False
#
# If neither DATABASE_URL nor DB_NAME is set, dev falls back to a local SQLite
# file (backend/db.sqlite3) so the server always boots.

# ── CORS / CSRF (comma-separated origins) ──────────────────────────────────
# Dev: handled by CORS_ALLOWED_ORIGIN_REGEXES in dev.py (regex-based).
# Prod: set explicit origins.
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# ── Google OAuth (Google One Tap login) ─────────────────────────────────────
# Must match the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ── Cloudinary (media storage) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (transactional email) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Web Push Notifications (VAPID) ─────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=private_key.pem
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_ADMIN_EMAIL=mailto:admin@yourdomain.com
